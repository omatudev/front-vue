# Environment Variables Template
# Copy this file to .env and fill with your actual values

# ==================== API Configuration ====================
VITE_API_BASE_URL=https://api.omatu.dev

# ==================== Groq API Configuration ====================
# AI-powered planning generation using Groq LLM
# Get your API key at: https://console.groq.com/keys
VITE_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
VITE_GROQ_API_KEY=gsk_your_api_key_here

# Groq Model Configuration
# Model: meta-llama/llama-4-scout-17b-16e-instruct (RECOMMENDED)
# Updated: October 12, 2025
# 
# Why llama-4-scout-17b-16e-instruct?
# - 30K tokens per minute (2.5x more than llama-3.3-70b)
# - 500K tokens per day (5x more than llama-3.3-70b)
# - Llama 4 architecture with better reasoning
# - Specialized in instruction-following (ideal for structured generation)
# - 16 expert mixture-of-experts (efficient and accurate)
#
# Alternative models available:
# - llama-3.3-70b-versatile (previous default, more general but slower)
# - llama-3.1-8b-instant (faster but less capable)
# - groq/compound (70K TPM but only 250 RPD)
VITE_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Groq API Settings
VITE_GROQ_MAX_TOKENS=8000
VITE_GROQ_TEMPERATURE=0.7
VITE_GROQ_REQUEST_TIMEOUT=60000

# ==================== App Configuration ====================
VITE_APP_NAME=Sistema de Planeaciones Académicas
VITE_APP_VERSION=1.0.0

# ==================== Document Processing ====================
# Maximum file size for DOCX uploads (in bytes)
# Default: 10485760 (10MB)
VITE_MAX_FILE_SIZE=10485760

# Minimum text length required after extraction (in characters)
VITE_MIN_TEXT_LENGTH=100

# ==================== Planning Configuration ====================
# Expected number of activities to generate
VITE_EXPECTED_ACTIVITIES_COUNT=6

# Minimum content length per activity (in characters)
VITE_MIN_ACTIVITY_CONTENT_LENGTH=50

# ==================== PDF Configuration ====================
# Institutional Logos (embedded as base64 in code)
# Logo paths are in: src/assets/imgBase64/

# ==================== API Timeouts ====================
# General API timeout (milliseconds)
VITE_API_TIMEOUT=10000

# AI Generation timeout (milliseconds) - longer for LLM processing
VITE_AI_GENERATION_TIMEOUT=60000

# ==================== Development Settings ====================
# Enable debug mode (logs API calls, state changes)
VITE_DEBUG=false

# Enable verbose logging
VITE_VERBOSE_LOGS=false

# ==================== Feature Flags ====================
# Enable retry logic for AI generation
VITE_ENABLE_AI_RETRY=true

# Maximum retries for AI generation
VITE_AI_MAX_RETRIES=2

# Enable localStorage persistence
VITE_ENABLE_LOCAL_STORAGE=true

# Enable PDF preview feature
VITE_ENABLE_PDF_PREVIEW=true
